{% extends "base.jinja2" %}

{% block head %}
<link rel="stylesheet" href="{{ static("base.css") }}">
{% endblock %}

{% block content %}
{% endblock %}

{% block after %}

<div class="lang-switch" role="group" aria-label="Language">
  <button type="button" class="lang-btn" data-lang="en" aria-label="Switch language to English" aria-pressed="true">EN</button>
  <button type="button" class="lang-btn" data-lang="ru" aria-label="Переключить язык на русский" aria-pressed="false">RU</button>
</div>
<div class="blur auth vert_center" role="dialog" aria-label="Telegram authentication">
  <div id="tg_icon" aria-hidden="true"></div>
  <div class="waiting_for_auth" role="status" aria-live="polite" data-i18n="waiting_auth">Waiting for authentification...</div>
  <div class="confirm_auth" data-i18n-html="confirm_auth">Please, confirm action in <span style="color:#28a0dc">Telegram</span></div>
</div>
<div class="auth-code-form blur" role="dialog" aria-label="Telegram login code">
  <div id="monkey" aria-hidden="true"></div>
  <div id="monkey-close" aria-hidden="true"></div>
  <span class="code-caption" id="code-caption" data-i18n="code_caption">Enter the code you recieved from Telegram</span>
  <label class="visually-hidden" for="code-input" data-i18n="code_label">Telegram code</label>
  <input type="text" id="code-input" class="code-input" autocomplete="off" aria-describedby="code-caption">
  <button type="button" class="enter" data-i18n="enter_btn">Enter</button>
</div>
<div class="eula-form blur" role="dialog" aria-label="End User License Agreement">
  <div class="vert_center" style="height: 100%">
    <div>
      <div id="law" aria-hidden="true"></div>
      <br><br>
      <span class="code-caption" data-i18n-html="eula_text">You are <span style="color:#c54245">prohibited</span> from adding more than 1 account
        on the current platform by its EULA.</span>
    </div>
  </div>
</div>
<div class="wrapper">
  <div class="blur main finish_block" role="region" aria-label="Installation complete">
    <div id="installation_icon" aria-hidden="true"></div>
    <h2 class="title" data-i18n="installed_title">Goroku is installed</h2>
    <p class="description">
      <span data-i18n="installed_desc">Goroku is installed. You can close this page now.</span>
      <br>
      <b data-i18n="installed_patience">It might take a while for installation to fully complete. Please, be patient.</b>
      <br>
      <b data-i18n="installed_restart">Goroku will restart and might send several configuration messages to complete the installation!</b>
      <br>
      <span style="font-size: 24px;" data-i18n-html="installed_check_tg">Check <span style="color:#28a0dc">Telegram</span> for a message from your <b>inline
          bot</b></span>
    </p>
  </div>
  <div class="blur main installation">
    <h1 class="title">
      <div class="goroku_label">
        <div class="label_inner">
          <img src="{{ platform_emoji }}" class="ringed_planet" alt="">
          &nbsp;Goroku
        </div>
      </div>
    </h1><br>
    <p class="description"><span data-i18n-html="best_userbot">Incomprehensibly <span style="color:#c54245">the best</span> userbot</span><br><span
        style="color: #18cc18; display: none" class="authorized" role="status" data-i18n="authorized">Authorized!</span></p>
    <div class="center">
      {% if not tg_done %}
      <button type="button" class="button" id="get_started">
        <div class="horiz_center">
          <div class="vert_center" data-i18n="get_started">
            Get started
          </div>

          <div class="vert_center">
            <i class="gg-arrow-right-r" aria-hidden="true"></i>
          </div>
        </div>
      </button>
      {% else %}
      <button type="button" class="button" id="get_started">
        <div class="horiz_center">
          <div class="vert_center" data-i18n="add_phone">
            Add phone
          </div>

          <div class="vert_center">
            <i class="gg-add" aria-hidden="true"></i>
          </div>
        </div>
      </button>
      {% endif %}
      {% if skip_creds and not lavhost %}
      <button type="button" class="button" id="enter_api">
        <div class="horiz_center">
          <div class="vert_center" data-i18n="change_api">
            Change API Creds
          </div>

          <div class="vert_center">
            <i class="gg-brackets" aria-hidden="true"></i>
          </div>
        </div>
      </button>
      {% endif %}
      <span id="block_api_id">
        <label class="api_id" for="api_id" data-i18n="api_id_label">Telegram API ID: </label>
        <input class="api_id" id="api_id" placeholder="••••" style="width: 4em;" inputmode="numeric" autocomplete="off">
      </span>
      <span id="block_api_hash">
        <label class="api_hash" for="api_hash" data-i18n="api_hash_label">Telegram API hash: </label>
        <input class="api_hash" id="api_hash" placeholder="••••••••••••••••••••••••••••••••" style="width: 24em;" autocomplete="off">
      </span>
      <span id="block_phone">
        <label class="phone" for="phone" data-i18n="phone_label">Phone: </label>
        <input class="phone" id="phone" placeholder="••••••••••••" style="width: 12em;" autocomplete="tel" inputmode="tel">
      </span>
      <span id="block_custom_bot">
        <label class="custom_bot" for="custom_bot" data-i18n="custom_bot_label">Inline bot username (E.g. @username_bot): </label>
        <input class="custom_bot" id="custom_bot" placeholder="Leave empty to generate automatically"
          style="width: 20em;" type="text" autocomplete="off">
      </span>
      <span id="block_qr_login">
        <div class="qr_outer">
          <div class="qr_inner">
            <div class="qr-spinner" role="img" aria-label="Loading QR code"></div>
          </div>
        </div>
        <div class="tg_guide">
          <ol>
            <li>
              <span data-i18n="qr_guide_1">Open Telegram on your phone</span>
            </li>
            <li>
              <span data-i18n-html="qr_guide_2">Go to <b>Settings</b> → <b>Devices</b> → <b>Link Desktop Device</b></span>
            </li>
            <li>
              <span data-i18n="qr_guide_3">Point your phone at this screen to confirm login</span>
            </li>
          </ol>
        </div>
      </span>
    </div>

    <div class="horiz_center">
      <button type="button" id="continue_btn" class="button">
        <div class="horiz_center">
          <div class="vert_center" data-i18n="continue">
            Continue
          </div>

          <div class="vert_center">
            <i class="gg-chevron-right-o" aria-hidden="true"></i>
          </div>
        </div>
      </button>
      <button type="button" id="denyqr" class="button">
        <div class="horiz_center">
          <div class="vert_center" data-i18n="auth_phone">
            Auth using phone instead
          </div>

          <div class="vert_center">
            <i class="gg-smartphone" aria-hidden="true"></i>
          </div>
        </div>
      </button>
    </div>
  </div>
  <div id="root">

  </div>
</div>
<script>
  var skip_creds = "{{ skip_creds }}" == "True";
  var auth_required = true;
  fetch("/check_session", {
    method: "POST",
    credentials: "include"
  })
    .then(response => response.text())
    .then((response) => {
      auth_required = response != "1";
    })
</script>
<script src="static/lottie-shim.js"></script>
<script src="static/qr-code-styling.min.js"></script>
<script src="{{ static("root.js") }}"></script>
{% endblock %}
