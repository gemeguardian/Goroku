<!DOCTYPE html>

<html lang="en">

<head>
  <title>Goroku userbot</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <!--
    R4.1: all frontend assets are vendored locally and embedded via goroku/web
    //go:embed. The onboarding panel works with zero external network access in
    the browser. The Content-Security-Policy is enforced by the Go handler
    (goroku/web/core.go setSecurityHeaders) and disallows external origins.
  -->
  <link rel="icon" href="static/cherry-blossom.png">
  <link rel="stylesheet" href="static/sweetalert2.min.css">
  <script src="static/jquery.min.js"></script>
  <script src="static/sweetalert2.min.js"></script>
  {% block head %}{% endblock %}
</head>

<body>
  <a href="#get_started" class="skip-link" data-i18n="skip_link">Skip to onboarding</a>
  <div class="main_content">{% block content %}{% endblock %}</div>
  {% block after %}{% endblock %}
</body>

</html>
