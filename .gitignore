# (no leading dot), so `go list ./...` walks into it unless ignored.
/go/

# Go build/tooling caches written into the repo by local build scripts.
/.go/
/.tmp/
/.config/

# Coverage profiles produced by `go test -coverprofile`.
/cover.out
/coverage.out

# User-downloaded module sources (outside package tree; not tracked)
/user_modules/

# tracking one here meant the embedded copy was never the thing being served.
/web-resources/

# Go build cache. Some local scripts point GOCACHE here; it reaches gigabytes
# and must never enter the repository or a Docker build context.
.cache/
